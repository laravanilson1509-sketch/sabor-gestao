# .env.local.example
# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# usadas só nas Edge Functions (nunca expostas no frontend)
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# ID da unidade — Supabase > Table Editor > unidades > copie o id da linha
# (temporário, até existir login multiunidade)
NEXT_PUBLIC_UNIDADE_ID=00000000-0000-0000-0000-000000000000
